# Скопируй файл в .env и задай нужные значения. По умолчанию используются значения
# из docker-compose.yml и application.yml, поэтому пустой .env тоже подходит.
#
# Значения рассчитаны на локальный стенд. Оплата имитируется, почта поступает в MailHog.
#
# Compose передаёт контейнерам настройки инфраструктуры, учётных данных, JWT,
# администратора, шлюза, оплаты, уведомлений и Saga. Параметры обработчика outbox,
# circuit breaker, повторных попыток, логов и трассировки применяются при запуске
# на хосте. Контейнеры берут эти параметры из application.yml.

# ---------------------------------------------------------------- инфраструктура
# Все опубликованные порты привязаны к этому адресу. 127.0.0.1 оставляет стенд
# доступным только на хосте. Перед привязкой к 0.0.0.0 выполни шаги в конце файла.
BIND_ADDRESS=127.0.0.1

# Значения предназначены только для локальной разработки. Перед доступом из сети
# замени каждый пароль по инструкции в конце файла.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

KAFKA_EXTERNAL_PORT=9094
# Адрес брокера, который Kafka сообщает клиентам. Для локального брокера подходит
# localhost. Для удалённого укажи адрес хоста, доступный клиентам.
KAFKA_EXTERNAL_HOST=localhost
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

REDIS_PORT=6380
# Пустое значение отключает аутентификацию Redis. Перед доступом из сети задай пароль.
# Redis будет требовать его, а шлюз использовать для подключения.
REDIS_PASSWORD=

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------------------------------------------------------------- базы сервисов
# Скрипт infra/postgres/init/01-create-databases.sh создаёт пользователей с этими
# параметрами. Он выполняется один раз при запуске с пустым томом.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_local_dev_only

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_local_dev_only

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_local_dev_only

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_local_dev_only

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_local_dev_only

DB_POOL_MAX_SIZE=5

# ---------------------------------------------------------------- потребители Kafka
# При запуске нескольких сервисов из одной оболочки у каждого своё значение.
# KAFKA_CONSUMER_GROUP=order-service
KAFKA_AUTO_OFFSET_RESET=earliest

# ---------------------------------------------------------------- порты сервисов
# SERVER_PORT переопределяет порт запускаемого сервиса (по умолчанию 8080–8085).
# SERVER_PORT=8082

# ---------------------------------------------------------------- маршруты шлюза
AUTH_SERVICE_URI=http://localhost:8081
ORDER_SERVICE_URI=http://localhost:8082
INVENTORY_SERVICE_URI=http://localhost:8083
PAYMENT_SERVICE_URI=http://localhost:8084
NOTIFICATION_SERVICE_URI=http://localhost:8085

# ---------------------------------------------------------------- api-gateway
# Адрес публичных ключей auth-service и ожидаемый издатель JWT. Ключи загружаются
# при первом обращении и сохраняются в кеше. Сервисы на servlet используют те же
# переменные через service-support и проверяют токен при прямом обращении.
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
# Значение AUTH_JWT_ISSUER должно совпадать со значением в auth-service.

# Разрешённые источники браузерных запросов, через запятую. Укажи схему, хост и порт.
GATEWAY_CORS_ORIGINS=http://localhost:5173

# Redis ведёт отдельный счётчик лимита для каждого маршрута и клиента. Ключом
# служит идентификатор пользователя из токена или IP. При сбое Redis шлюз
# пишет WARN и пропускает запрос. Проверка доступа выполняется отдельно.
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_REQUESTED_TOKENS=1

# Используется тот же Redis. Короткие тайм-ауты ограничивают задержку запроса
# перед тем, как шлюз пропустит его при недоступности Redis.
REDIS_HOST=localhost
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms

# ---------------------------------------------------------------- auth-service
# Ключи подписи RS256. При пустых настройках auth-service генерирует временную
# пару RSA на 2048 бит и пишет WARN. После перезапуска старые токены недействительны.
# Храни закрытый ключ в локальном .env или хранилище секретов. Генерация ключей:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Поддерживаются многострочные PEM и одна строка с буквальными последовательностями \n.
# AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
# AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----
# Идентификатор ключа в JWKS и заголовке JWT. По умолчанию случайный UUID.
# AUTH_JWT_KEY_ID=auth-2025-01
AUTH_JWT_ISSUER=order-processing-auth
AUTH_JWT_EXPIRATION=PT1H

# Идемпотентное создание администратора при запуске.
AUTH_ADMIN_EMAIL=admin@orders.local
AUTH_ADMIN_PASSWORD=Admin@LocalDevOnly
AUTH_ADMIN_NAME=Platform Admin

# ---------------------------------------------------------------- inventory-service
# Загружает демонстрационный каталог. Повторный запуск сопоставляет товары по SKU
# и сохраняет текущие остатки. По умолчанию выключено вне локального стенда.
INVENTORY_SEED_DEMO=true
# Число попыток резервирования, освобождения или подтверждения при конфликте версий. Затем возвращается 409.
INVENTORY_RESERVATION_MAX_ATTEMPTS=3
# При сверке резервов inventory-service проверяет статус через GET /api/orders/{id}
# с токеном администратора. Обрабатываются только CANCELLED и REJECTED. В Compose
# адрес http://order-service:8082. После трёх последовательных сбоев остальные
# записи запроса будут пропущены.
ORDER_BASE_URL=http://localhost:8082
ORDER_CONNECT_TIMEOUT_MS=1000
ORDER_READ_TIMEOUT_MS=2000

# ---------------------------------------------------------------- order-service
# Адрес inventory-service для чтения цен. Снимок цен формируется на сервере при оформлении.
INVENTORY_BASE_URL=http://localhost:8083
# Короткие тайм-ауты ограничивают задержку POST /api/orders при сбое склада.
INVENTORY_CONNECT_TIMEOUT_MS=1000
INVENTORY_READ_TIMEOUT_MS=2000
# Повтор и circuit breaker применяются к тайм-аутам, обрывам соединения и 5xx.
# Неизвестный товар считается ошибкой запроса и не приводит к повтору.
INVENTORY_RETRY_MAX_ATTEMPTS=3
INVENTORY_RETRY_WAIT=200ms
INVENTORY_CB_WINDOW=20
INVENTORY_CB_MINIMUM_CALLS=10
INVENTORY_CB_FAILURE_RATE=50
INVENTORY_CB_OPEN_WAIT=10s
INVENTORY_CB_HALF_OPEN_CALLS=3

# Записи outbox_events сохраняются в одной транзакции с заказом. Планировщик
# забирает их через FOR UPDATE SKIP LOCKED, что позволяет работать нескольким экземплярам.
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_SEND_TIMEOUT=PT15S
# Срок хранения опубликованных записей для аудита.
OUTBOX_RETENTION=P7D
OUTBOX_CLEANUP_MS=3600000
# Значение false оставляет обработчик доступным, но отключает его планировщик.
OUTBOX_SCHEDULER_ENABLED=true

# После тайм-аута Saga отменяет заказ с компенсацией: освобождением резерва,
# возвратом платежа и уведомлением.
ORDER_SAGA_TIMEOUT=PT2M

# Интервал повторной команды RefundPayment отсчитывается от последней попытки.
# Задача запускается вместе с проверкой тайм-аутов, но возврат выполняется один раз
# на заказ даже при повторной команде.
ORDER_SAGA_REFUND_RETRY_INTERVAL=PT30S

# ---------------------------------------------------------------- payment-service
# Имитатор оплаты меняет записи в таблице payments. Он не обращается к эквайеру
# и не принимает реквизиты карт. Идентификаторы имеют префикс SIM-, ответы API
# содержат "simulated": true. Подробности в разделе README «Что симулируется».
PAYMENT_DECLINE_ABOVE=1000.00
PAYMENT_FAILURE_RATE=0
# Число попыток обработки команды платежа при конфликте версий.
PAYMENT_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- notification-service
# SMTP-отправитель для локального MailHog. В API поле "simulated": true, а статус
# показывает, принял ли приёмник письмо. Повторная доставка события может привести
# к повторной отправке. Если все попытки исчерпаны, сервис пишет WARN.
NOTIFICATION_FROM=orders@orders.local
# Адрес получает вид <customerId>@NOTIFICATION_RECIPIENT_DOMAIN. Он предназначен
# для MailHog. Не используй домен, на который доставляется реальная почта.
NOTIFICATION_RECIPIENT_DOMAIN=customers.orders.local

# ---------------------------------------------------------------- Actuator и логи
MANAGEMENT_ENDPOINTS=health,info
MANAGEMENT_HEALTH_SHOW_DETAILS=always
# Только для api-gateway. Значение "none" скрывает /actuator/gateway/routes.
MANAGEMENT_GATEWAY_ENDPOINT_ACCESS=unrestricted
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_GATEWAY=INFO

# ---------------------------------------------------------------- наблюдаемость
# Спаны отправляются по OTLP/HTTP в Jaeger (профиль observability).
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
# Переменная управляет только экспортом спанов. Идентификаторы в логах и traceparent
# в Kafka работают всегда. По умолчанию экспорт включён на хосте и отключён в
# профиле app. Без коллектора каждая попытка экспорта пишет ERROR. Включай переменную
# для контейнеров вместе с observability:
#   docker compose --profile app --profile observability up -d
# На хосте без Jaeger укажи false.
# OTLP_TRACING_EXPORT_ENABLED=true
# Доля запросов с трассировкой (1.0 — все запросы).
TRACING_SAMPLING_PROBABILITY=1.0
# Пароль администратора Grafana. Анонимным пользователям доступно только чтение.
GRAFANA_ADMIN_PASSWORD=grafana_local_dev_only

# ---------------------------------------------------------------- подготовка к запуску в сети
# Значения по умолчанию предназначены для локальной разработки. Перед запуском в сети:
#
# 1. Явно задай BIND_ADDRESS=0.0.0.0, если нужен доступ извне.
# 2. Замени *_PASSWORD и *_SUPERUSER_PASSWORD. Скрипт создаёт пользователей PostgreSQL
#    при первом запуске на пустом томе.
# 3. Укажи постоянные AUTH_JWT_PRIVATE_KEY и AUTH_JWT_PUBLIC_KEY. Без них ключи и
#    выданные токены теряются при перезапуске.
# 4. Задай доступный клиентам KAFKA_EXTERNAL_HOST. Включай OTLP_TRACING_EXPORT_ENABLED
#    только с профилем observability.
# 5. Оставь Postgres, Kafka, Redis и MailHog в закрытой сети или за межсетевым экраном.
